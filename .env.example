# Generate SECRET_KEY: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=code_share
DB_PASSWORD=
DB_NAME=code_share
# Enable only when serving over HTTPS.
SESSION_COOKIE_SECURE=false
LOGIN_RATE_LIMIT=5 per minute;30 per hour
# Local single-process use only. For multiple workers use a shared backend.
RATELIMIT_STORAGE_URI=memory://
# Optional: location of mysql and mysqldump clients for migrations/backups.
# MYSQL_BIN_DIR=C:/Program Files/MySQL/MySQL Server 8.0/bin
