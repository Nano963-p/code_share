{
  "table:comments": [
    "`created_at`datetimenotnulldefaultcurrent_timestamp",
    "`id`intnotnullauto_increment",
    "`message`varchar(1000)notnull",
    "`project_id`intnotnull",
    "`user_id`intnotnull",
    "constraint`chk_comment_len`check((char_length(`message`)between1and1000))",
    "constraint`fk_comments_project`foreignkey(`project_id`)references`projects`(`id`)ondeletecascade",
    "constraint`fk_comments_user`foreignkey(`user_id`)references`users`(`id`)ondeletecascade",
    "key`idx_comments_project_created`(`project_id`,`created_at`)",
    "key`idx_comments_user`(`user_id`)",
    "primarykey(`id`)",
    ")engine=innodb"
  ],
  "table:files": [
    "`filename`varchar(255)notnull",
    "`filepath`varchar(500)notnull",
    "`filesize`bigintnotnull",
    "`id`intnotnullauto_increment",
    "`project_id`intnotnull",
    "`sha256`char(64)defaultnull",
    "`uploaded_at`datetimenotnulldefaultcurrent_timestamp",
    "`uploaded_by`intnotnull",
    "constraint`chk_filesize_limit`check((`filesize`<=41943040))",
    "constraint`chk_filesize_positive`check((`filesize`>0))",
    "constraint`fk_files_project`foreignkey(`project_id`)references`projects`(`id`)ondeletecascade",
    "constraint`fk_files_uploader`foreignkey(`uploaded_by`)references`users`(`id`)ondeletecascade",
    "key`idx_files_project`(`project_id`)",
    "key`idx_files_sha256`(`sha256`)",
    "key`idx_files_uploaded_at`(`uploaded_at`)",
    "key`idx_files_uploader`(`uploaded_by`)",
    "primarykey(`id`)",
    "uniquekey`uq_files_project_filepath`(`project_id`,`filepath`)",
    ")engine=innodb"
  ],
  "table:followers": [
    "`created_at`datetimenotnulldefaultcurrent_timestamp",
    "`follower_id`intnotnull",
    "`following_id`intnotnull",
    "constraint`chk_no_self_follow`check((`follower_id`<>`following_id`))",
    "constraint`fk_followers_follower`foreignkey(`follower_id`)references`users`(`id`)ondeletecascade",
    "constraint`fk_followers_following`foreignkey(`following_id`)references`users`(`id`)ondeletecascade",
    "key`idx_followers_follower`(`follower_id`)",
    "key`idx_followers_following`(`following_id`)",
    "primarykey(`follower_id`,`following_id`)",
    ")engine=innodb"
  ],
  "table:project_activity": [
    "`action`varchar(50)notnull",
    "`created_at`datetimenotnulldefaultcurrent_timestamp",
    "`entity_id`bigintdefaultnull",
    "`entity_type`enum('project','member','file','comment','star')notnull",
    "`id`bigintnotnullauto_increment",
    "`project_id`intnotnull",
    "`user_id`intdefaultnull",
    "constraint`fk_activity_project`foreignkey(`project_id`)references`projects`(`id`)ondeletecascade",
    "constraint`fk_activity_user`foreignkey(`user_id`)references`users`(`id`)ondeletesetnull",
    "key`idx_activity_project_created`(`project_id`,`created_at`)",
    "key`idx_activity_user_created`(`user_id`,`created_at`)",
    "primarykey(`id`)",
    ")engine=innodb"
  ],
  "table:project_languages": [
    "`created_at`datetimenotnulldefaultcurrent_timestamp",
    "`language_norm`varchar(50)generatedalwaysas(lower(trim(`language`)))storednotnull",
    "`language`varchar(50)notnull",
    "`project_id`intnotnull",
    "constraint`chk_language_len`check((char_length(`language`)between1and50))",
    "constraint`fk_pl_project`foreignkey(`project_id`)references`projects`(`id`)ondeletecascade",
    "key`idx_pl_language_norm`(`language_norm`)",
    "key`idx_pl_project`(`project_id`)",
    "primarykey(`project_id`,`language_norm`)",
    ")engine=innodb"
  ],
  "table:project_members": [
    "`joined_at`datetimenotnulldefaultcurrent_timestamp",
    "`project_id`intnotnull",
    "`role`enum('owner','admin','member')notnulldefault'member'",
    "`user_id`intnotnull",
    "constraint`fk_pm_project`foreignkey(`project_id`)references`projects`(`id`)ondeletecascade",
    "constraint`fk_pm_user`foreignkey(`user_id`)references`users`(`id`)ondeletecascade",
    "key`idx_pm_role`(`project_id`,`role`)",
    "key`idx_pm_user`(`user_id`)",
    "primarykey(`project_id`,`user_id`)",
    ")engine=innodb"
  ],
  "table:project_tags": [
    "`created_at`datetimenotnulldefaultcurrent_timestamp",
    "`project_id`intnotnull",
    "`tag_id`intnotnull",
    "constraint`fk_pt_project`foreignkey(`project_id`)references`projects`(`id`)ondeletecascade",
    "constraint`fk_pt_tag`foreignkey(`tag_id`)references`tags`(`id`)ondeletecascade",
    "key`idx_project_tags_tag`(`tag_id`)",
    "primarykey(`project_id`,`tag_id`)",
    ")engine=innodb"
  ],
  "table:projects": [
    "`created_at`datetimenotnulldefaultcurrent_timestamp",
    "`description`varchar(2000)defaultnull",
    "`downloads`intnotnulldefault'0'",
    "`id`intnotnullauto_increment",
    "`is_private`tinyint(1)notnulldefault'0'",
    "`language`varchar(50)defaultnull",
    "`owner_id`intnotnull",
    "`status`enum('active','archived')notnulldefault'active'",
    "`title`varchar(100)notnull",
    "`updated_at`datetimenotnulldefaultcurrent_timestamponupdatecurrent_timestamp",
    "constraint`chk_project_title_len`check((char_length(`title`)between3and100))",
    "constraint`fk_projects_owner`foreignkey(`owner_id`)references`users`(`id`)ondeletecascade",
    "key`idx_projects_created_at`(`created_at`)",
    "key`idx_projects_downloads`(`downloads`)",
    "key`idx_projects_owner`(`owner_id`)",
    "key`idx_projects_status`(`status`)",
    "key`idx_projects_visibility`(`is_private`)",
    "primarykey(`id`)",
    ")engine=innodb"
  ],
  "table:role_permissions": [
    "`allowed`tinyint(1)notnulldefault'1'",
    "`permission`enum('project_view_private','project_edit','project_delete','members_manage','files_upload','files_delete','comments_create','stars_toggle')notnull",
    "`role`enum('owner','admin','member')notnull",
    "primarykey(`role`,`permission`)",
    ")engine=innodb"
  ],
  "table:stars": [
    "`created_at`datetimenotnulldefaultcurrent_timestamp",
    "`project_id`intnotnull",
    "`user_id`intnotnull",
    "constraint`fk_stars_project`foreignkey(`project_id`)references`projects`(`id`)ondeletecascade",
    "constraint`fk_stars_user`foreignkey(`user_id`)references`users`(`id`)ondeletecascade",
    "key`idx_stars_project`(`project_id`)",
    "key`idx_stars_user_created`(`user_id`,`created_at`)",
    "primarykey(`user_id`,`project_id`)",
    ")engine=innodb"
  ],
  "table:tags": [
    "`id`intnotnullauto_increment",
    "`name_norm`varchar(50)generatedalwaysas(lower(trim(`name`)))stored",
    "`name`varchar(50)notnull",
    "constraint`chk_tag_format`check(regexp_like(`name`,_utf8mb4'^[a-za-z0-9_\\\\-]+$'))",
    "constraint`chk_tag_len`check((char_length(`name`)between1and50))",
    "primarykey(`id`)",
    "uniquekey`uq_tags_name_norm`(`name_norm`)",
    ")engine=innodb"
  ],
  "table:user_activity": [
    "`action`varchar(50)notnull",
    "`created_at`datetimenotnulldefaultcurrent_timestamp",
    "`id`bigintnotnullauto_increment",
    "`target_user_id`intnotnull",
    "`user_id`intnotnull",
    "constraint`fk_user_activity_target`foreignkey(`target_user_id`)references`users`(`id`)ondeletecascade",
    "constraint`fk_user_activity_user`foreignkey(`user_id`)references`users`(`id`)ondeletecascade",
    "key`idx_user_activity_target_created`(`target_user_id`,`created_at`)",
    "key`idx_user_activity_user_created`(`user_id`,`created_at`)",
    "primarykey(`id`)",
    ")engine=innodb"
  ],
  "table:users": [
    "`bio`varchar(500)defaultnull",
    "`created_at`datetimenotnulldefaultcurrent_timestamp",
    "`email_norm`varchar(100)generatedalwaysas(lower(trim(`email`)))stored",
    "`email`varchar(100)notnull",
    "`id`intnotnullauto_increment",
    "`password_hash`varchar(255)notnull",
    "`profile_image`varchar(500)defaultnull",
    "`username_norm`varchar(30)generatedalwaysas(lower(trim(`username`)))stored",
    "`username`varchar(30)notnull",
    "constraint`chk_email_format`check(regexp_like(`email`,_utf8mb4'^[a-za-z0-9._%+-]+@[a-za-z0-9.-]+\\\\.[a-za-z]{2,}$'))",
    "constraint`chk_username_format`check(regexp_like(`username`,_utf8mb4'^[a-za-z0-9_]+$'))",
    "constraint`chk_username_len`check((char_length(`username`)between3and30))",
    "key`idx_users_created_at`(`created_at`)",
    "primarykey(`id`)",
    "uniquekey`uq_users_email_norm`(`email_norm`)",
    "uniquekey`uq_users_username_norm`(`username_norm`)",
    ")engine=innodb"
  ],
  "trigger:trg_projects_ai_add_owner_member": "createtrigger`trg_projects_ai_add_owner_member`afterinserton`projects`foreachrowbegininsertintoproject_members(project_id,user_id,role)values(new.id,new.owner_id,'owner')onduplicatekeyupdaterole='owner';end",
  "trigger:trg_projects_au_sync_owner_member": "createtrigger`trg_projects_au_sync_owner_member`afterupdateon`projects`foreachrowbeginifnew.owner_id<>old.owner_idthenupdateproject_memberssetrole='admin'whereproject_id=new.idanduser_id=old.owner_idandrole='owner';insertintoproject_members(project_id,user_id,role)values(new.id,new.owner_id,'owner')onduplicatekeyupdaterole='owner';endif;end",
  "trigger:trg_pm_bi_enforce_owner_rules": "createtrigger`trg_pm_bi_enforce_owner_rules`beforeinserton`project_members`foreachrowbegindeclareproj_ownerint;selectowner_idintoproj_ownerfromprojectswhereid=new.project_id;ifproj_ownerisnullthensignalsqlstate'45000'setmessage_text='projectdoesnotexist.';endif;ifnew.user_id=proj_ownerandnew.role<>'owner'thensignalsqlstate'45000'setmessage_text='theprojectownermusthaverole=owner.';endif;ifnew.role='owner'thenifnew.user_id<>proj_ownerthensignalsqlstate'45000'setmessage_text='onlyprojects.owner_idcanberole=owner.';endif;ifexists(select1fromproject_memberswhereproject_id=new.project_idandrole='owner')thensignalsqlstate'45000'setmessage_text='aprojectcanhaveonlyoneowner.';endif;endif;end",
  "trigger:trg_pm_bu_enforce_owner_rules": "createtrigger`trg_pm_bu_enforce_owner_rules`beforeupdateon`project_members`foreachrowbegindeclareproj_ownerint;selectowner_idintoproj_ownerfromprojectswhereid=new.project_id;ifproj_ownerisnullthensignalsqlstate'45000'setmessage_text='projectdoesnotexist.';endif;ifnew.user_id=proj_ownerandnew.role<>'owner'thensignalsqlstate'45000'setmessage_text='cannotdemotetheprojectowner.transferownershipfirst.';endif;ifnew.role='owner'thenifnew.user_id<>proj_ownerthensignalsqlstate'45000'setmessage_text='onlyprojects.owner_idcanberole=owner.';endif;ifexists(select1fromproject_memberswhereproject_id=new.project_idandrole='owner'anduser_id<>new.user_id)thensignalsqlstate'45000'setmessage_text='aprojectcanhaveonlyoneowner.';endif;endif;ifold.role='owner'andnew.role<>'owner'thenifold.user_id=proj_ownerthensignalsqlstate'45000'setmessage_text='cannotdemotecurrentowner.transferownershipfirst.';endif;endif;end",
  "trigger:trg_pm_bd_block_owner_delete": "createtrigger`trg_pm_bd_block_owner_delete`beforedeleteon`project_members`foreachrowbeginifold.role='owner'thensignalsqlstate'45000'setmessage_text='cannotdeletetheownermembership.';endif;end",
  "procedure:transfer_project_ownership": "createprocedure`transfer_project_ownership`(inp_project_idint,inp_new_owner_idint)beginupdateprojectssetowner_id=p_new_owner_idwhereid=p_project_id;end"
}
